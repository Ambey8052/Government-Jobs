PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (get from https://cloud.mongodb.com -> Connect -> Drivers)
MONGO_URI=mongodb+srv://qelmiopvtltd_db_user:<db_password>@cluster0.jegjf2v.mongodb.net/?appName=Cluster0

# Long random string used to sign JWTs (any random 32+ char string)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# URL of the running React client (for CORS + cookie settings)
CLIENT_URL=http://localhost:5173

# Gemini API key for AI-powered natural-language search query parsing
# (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
